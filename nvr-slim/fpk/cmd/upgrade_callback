#!/bin/bash
# 升级后：补齐新版默认配置项，保留用户已有设置
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"
APP_DIR="${TRIM_APPDEST:-$ROOT/app}"
VAR_DIR="${TRIM_PKGVAR:-$ROOT/var}"
TMPLOG="${TRIM_TEMP_LOGFILE:-}"

fail() {
  printf '%s\n' "$1" >&2
  [ -n "$TMPLOG" ] && printf '%s\n' "$1" >>"$TMPLOG"
  exit 1
}

PY=""
for c in "${NVR_PYTHON:-}" python3 python; do
  [ -n "$c" ] || continue
  if command -v "$c" >/dev/null 2>&1; then PY="$(command -v "$c")"; break; fi
done
[ -n "$PY" ] || fail "系统未找到 python3"

"$PY" "$APP_DIR/server/runtime.py" --var "$VAR_DIR" --app "$APP_DIR" migrate >/dev/null 2>&1 \
  || fail "配置迁移失败，可回滚到 $VAR_DIR/backup 下的备份"

# 升级会整目录替换 app：包内 ui/config 的端口是新包默认值，而用户配置里还是老端口。
# 不对齐的话，桌面图标指向一个没人监听的端口，用户点开就是 ERR_CONNECTION_REFUSED
# （0.9.18 真机实锤）。这里把图标拉回用户现有端口；启动阶段 main 的 pinport 还会
# 用 port.txt 的真实端口再兜一次。
PORT_HAVE="$(sed -n 's/.*"service_port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
  "$VAR_DIR/config.json" 2>/dev/null | head -1)"
if [ -n "$PORT_HAVE" ]; then
  mkdir -p "$VAR_DIR/log" 2>/dev/null || true
  "$PY" "$APP_DIR/server/runtime.py" --var "$VAR_DIR" --app "$APP_DIR" \
    pinport --port "$PORT_HAVE" >>"$VAR_DIR/log/upgrade.log" 2>&1 || true
fi

mkdir -p "$VAR_DIR/slots" "$VAR_DIR/log" "$VAR_DIR/rec" 2>/dev/null

# 升级会整目录替换 app，但数据目录通常不动；只有属主被改过才修（幂等且不慢）
APP_USER="nvr"
if [ -f "$ROOT/config/privilege" ]; then
  _u="$(sed -n 's/.*"username"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$ROOT/config/privilege" 2>/dev/null | head -1)"
  [ -n "$_u" ] && APP_USER="$_u"
fi
if [ -d "$VAR_DIR" ] && [ "$(stat -c %U "$VAR_DIR" 2>/dev/null || echo '')" != "$APP_USER" ]; then
  chown -R "$APP_USER:$APP_USER" "$VAR_DIR" 2>/dev/null || true
  chmod 700 "$VAR_DIR" 2>/dev/null || true
fi

# 升级替换了 app 代码。若 upgrade_init 的 stop 没把旧进程杀干净（数据目录 env 不一致时
# PID 文件会落空），这里兜底重启一次，确保后台跑的是新代码。否则会出现
# 「新前端 + 旧后端」的错位：日志接口 404 回退成网页、健康检查不返回版本号，
# 用户看到的就是「服务端版本 v?」「无法读取日志：text/html」。
"$SELF_DIR/main" stop >/dev/null 2>&1
"$SELF_DIR/main" start >/dev/null 2>&1 || true

exit 0
