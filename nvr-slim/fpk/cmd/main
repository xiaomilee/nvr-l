#!/bin/bash
# NVR 生命周期核心：start / stop / status
# fnOS 约定：status 返回 0 = 运行中，3 = 未运行，其它 = 异常
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"
APP_DIR="${TRIM_APPDEST:-$ROOT/app}"
VAR_DIR="${TRIM_PKGVAR:-$ROOT/var}"
# 裸调兜底：飞牛通过 TRIM_APPDEST/TRIM_PKGVAR 告诉脚本真实路径，但手工排障时
# 直接 su 过来跑是没有这两个变量的——机器布局里 app/ 子目录不存在，程序在
# target 符号链接指向的应用目录里。不兜底的话 start 会报「程序文件缺失」，
# 而报错里看不到「少设了环境变量」这层原因。
if [ ! -d "$APP_DIR" ] && [ -d "$ROOT/target" ]; then
  APP_DIR="$ROOT/target"
fi
PORT="${TRIM_SERVICE_PORT:-18080}"
# 用户可能在向导/应用设置里改过端口，配置里的值优先于 manifest 的静态声明
if [ -f "$VAR_DIR/config.json" ]; then
  _cp="$(sed -n 's/.*"service_port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
    "$VAR_DIR/config.json" 2>/dev/null | head -1)"
  [ -n "$_cp" ] && PORT="$_cp"
fi
PID_FILE="$VAR_DIR/app.pid"
LOG_DIR="$VAR_DIR/log"
LOG_FILE="$LOG_DIR/app.log"
TMPLOG="${TRIM_TEMP_LOGFILE:-}"

fail() {
  printf '%s\n' "$1" >&2
  [ -n "$TMPLOG" ] && printf '%s\n' "$1" >>"$TMPLOG"
  exit 1
}

find_python() {
  local c
  for c in "${NVR_PYTHON:-}" python3 python; do
    [ -n "$c" ] || continue
    if command -v "$c" >/dev/null 2>&1; then
      command -v "$c"
      return 0
    fi
  done
  return 1
}

pid_alive() {
  local pid="$1"
  [ -n "$pid" ] || return 1
  if kill -0 "$pid" 2>/dev/null; then return 0; fi
  # Git Bash / 部分精简系统上 kill 对非子进程无效，用 tasklist 兜底
  if command -v tasklist >/dev/null 2>&1; then
    tasklist //FI "PID eq $pid" 2>/dev/null | grep -q "$pid" && return 0
  fi
  return 1
}

# TCP 端口探测：连得上 = 服务在听。判活的最后一级兜底——kill -0 在「执行者不是
# 进程属主」时会因 EPERM 失败（152 真机实测：应用以 nvr 用户跑，其他身份执行
# status 必然误报「未运行」），跨用户场景只有 TCP 连接与权限无关。
port_alive() {
  local port="${1:-}"
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || return 1
  exec 3>&- 3<&- 2>/dev/null
  return 0
}

kill_pid() {
  local pid="$1" sig="${2:-TERM}"
  kill "-$sig" "$pid" 2>/dev/null && return 0
  if command -v taskkill >/dev/null 2>&1; then
    taskkill //PID "$pid" //F >/dev/null 2>&1 && return 0
  fi
  return 1
}

read_pid() {
  [ -f "$PID_FILE" ] || return 1
  tr -d '[:space:]' <"$PID_FILE"
}

find_server_pids() {
  # PID 文件丢失/对不上时的兜底：按进程命令行扫出本应用的 nvr_slim.py 进程。
  # 匹配 nvr_slim.py 且命令行带本应用目录（app/var/root 之一），避免误杀别的实例。
  #
  # 只认 python 打头的进程：纯字符串匹配会被调用方自己骗过——`sh -c "… main
  # status … grep nvr_slim.py …"` 这类复合命令的 cmdline 同时含「nvr_slim.py +
  # 应用路径」，status 曾因此对着一具尸体报「运行中」（152 实测）。服务进程
  # 的命令行永远是 `python3 nvr_slim.py …`，第一个词必含 python。
  local p c c1 d
  for p in /proc/[0-9]*/cmdline; do
    [ -r "$p" ] || continue
    c="$(tr '\0' ' ' <"$p" 2>/dev/null)"
    case "$c" in
      *nvr_slim.py*)
        c1="${c%% *}"
        case "$c1" in
          *python*)
            case "$c" in
              *"$APP_DIR"*|*"$VAR_DIR"*|*"$ROOT"*)
                d="${p%/cmdline}"; d="${d#/proc/}"
                echo "$d"
                ;;
            esac
            ;;
        esac
        ;;
    esac
  done
}

wait_health() {
  local py="$1" timeout="${2:-30}"
  "$py" - "$PORT" "$timeout" "$VAR_DIR/port.txt" <<'PYEOF'
import sys, time, urllib.error, urllib.request

def ready(port):
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/api/health" % port, timeout=1) as r:
            return r.status == 200
    except urllib.error.HTTPError as e:
        # 0.9.120 起 /api/health 也要凭证。401/403 说明进程已经起来了、只是在
        # 等凭证——这恰恰是"启动成功"。把它当失败会让 start 一直等到超时，
        # 然后判定"服务没起来"并把刚起好的进程收掉。
        return e.code in (401, 403)
    except Exception:
        return False

want, timeout, pfile = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
deadline = time.time() + timeout
while time.time() < deadline:
    # 服务在端口被占时会顺延，真实端口写在 port.txt；但这个文件是**上一轮**留下的。
    # 只读一次就会拿旧端口死探到底——测试机上真发生过：port.txt 还留着上次顺延的
    # 18084，新进程其实占了 18083，于是整整 30 秒都在敲一扇没人的门，
    # 最后判"服务启动超时"、把刚起好的进程收掉。每轮重读，并且两个端口都探。
    ports = [want]
    try:
        v = open(pfile, encoding="utf-8").read().strip()
        if v.isdigit() and int(v) != want:
            ports.append(int(v))
    except OSError:
        pass
    for p in ports:
        if ready(p):
            sys.exit(0)
    time.sleep(0.3)
sys.exit(1)
PYEOF
}

start() {
  local py pid
  py="$(find_python)" || fail "未找到 python3，请检查系统环境"
  [ -f "$APP_DIR/server/nvr_slim.py" ] || fail "程序文件缺失：$APP_DIR/server/nvr_slim.py"

  mkdir -p "$VAR_DIR" "$LOG_DIR" "$VAR_DIR/slots" 2>/dev/null
  # 写探针前置：目录属主/ACL 异常时，这里报错比后面"写日志失败/服务起不来"好排查得多
  probe="$VAR_DIR/.write-probe.$$"
  if ! ( : >"$probe" ) 2>/dev/null; then
    fail "数据目录不可写：$VAR_DIR（属主 $(stat -c %U "$VAR_DIR" 2>/dev/null || echo unknown)）。在终端执行 chown -R <应用用户>:<应用用户> \"$VAR_DIR\" && chmod 700 \"$VAR_DIR\" 后重试"
  fi
  rm -f "$probe" 2>/dev/null

  # 幂等：PID 文件说在跑，或按命令行扫到本应用的服务进程在跑，都不再起第二个。
  # 只看 PID 文件不够——0.9.140 之前文件里存的是 bash 壳的进程号（见下方 spawn 处
  # 的注释），壳活着 python 未必是「这一份」；反过来壳死了孤儿 python 还占着端口，
  # 再起一个只会顺延端口、越积越多。
  if pid="$(read_pid)" && pid_alive "$pid"; then
    exit 0
  fi
  for pid in $(find_server_pids); do
    [ -n "$pid" ] || continue
    printf '%s\n' "$pid" >"$PID_FILE" 2>/dev/null || true
    exit 0
  done
  rm -f "$PID_FILE"

  # 打包带的静态 ffmpeg/ffprobe 在个别解包场景会丢执行位，启动前兜一次
  for _b in "$APP_DIR/bin/ffmpeg" "$APP_DIR/bin/ffprobe"; do
    [ -f "$_b" ] && chmod +x "$_b" 2>/dev/null || true
  done

  # 日志单文件滚动，避免长期运行把数据分区写满
  if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE" 2>/dev/null || echo 0)" -gt 2097152 ]; then
    mv -f "$LOG_FILE" "$LOG_FILE.1"
  fi

  {
    echo "---- $(date '+%Y-%m-%d %H:%M:%S') start v$(grep -m1 '^version=' "$ROOT/manifest" 2>/dev/null | cut -d= -f2) ----"
  } >>"$LOG_FILE" 2>/dev/null

  # spawn 服务。0.9.140 修正一个致命的 shell 细节：旧写法把 & 挂在整条
  # 「cd && nohup python」列表上——$! 取到的是后台 bash 壳的进程号，壳又在前台
  # 等着 python，于是 PID 文件里永远是壳。stop 只杀壳，python 变孤儿继续监听
  # 端口继续录像，应用中心却显示「停用成功」——152 上用户看到的正是这个。
  # 现在 & 只作用于 nohup python 一条命令，$! 就是 python 本尊；壳（子 shell）
  # 写完 PID 文件即退出，python 过继给 init。
  ( cd "$APP_DIR/server" || exit 1
    nohup "$py" nvr_slim.py \
      --port "$PORT" --host "${TRIM_LISTEN_HOST:-0.0.0.0}" --var "$VAR_DIR" --app "$APP_DIR" --ui "$APP_DIR/ui" \
      >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE" )

  pid="$(read_pid)"
  [ -n "$pid" ] || fail "服务未能启动（未取得进程号），详见 $LOG_FILE"

  if ! wait_health "$py" 30; then
    kill_pid "$pid" KILL >/dev/null 2>&1
    rm -f "$PID_FILE"
    fail "服务启动超时（端口 $PORT）。最近的日志：$(tail -n 8 "$LOG_FILE" 2>/dev/null | tr '\n' ' ')"
  fi

  # 实际监听端口可能不等于 manifest 默认值（被占用时顺延）。桌面图标的端口
  # 若还没跟上，这里补一次：启动阶段应用目录通常已归属应用用户，比安装期更可能写得进去。
  # 写不进去也不影响服务运行，只是图标仍指向默认端口。
  actual="$(tr -dc '0-9' <"$VAR_DIR/port.txt" 2>/dev/null)"
  if [ -n "$actual" ]; then
    "$py" "$APP_DIR/server/runtime.py" --var "$VAR_DIR" --app "$APP_DIR" \
      pinport --port "$actual" >>"$LOG_FILE" 2>&1 || true
    [ "$actual" = "$PORT" ] || echo "note: 端口顺延 $PORT -> $actual" >>"$LOG_FILE" 2>/dev/null
  fi
  exit 0
}

stop() {
  local pid i killed
  # 第一优先：PID 文件指谁就先收拾谁（新版本里是 python 本尊）
  pid="$(read_pid)" || true
  if [ -n "$pid" ] && pid_alive "$pid"; then
    kill_pid "$pid" TERM
    i=0
    while [ "$i" -lt 40 ]; do
      pid_alive "$pid" || break
      sleep 0.25
      i=$((i + 1))
    done
    if pid_alive "$pid"; then
      kill_pid "$pid" KILL
      sleep 0.5
    fi
    if pid_alive "$pid"; then
      fail "无法停止进程 $pid"
    fi
  fi
  # 第二优先：按命令行全扫兜底，**无论上面杀没杀成功都执行**。0.9.140 之前
  # PID 文件存的是 bash 壳，壳被 TERM 后 python 成孤儿继续录像——只信 PID 文件
  # 的 stop 就是这样把「停用成功」变成一句空话的。孤儿只有靠命令行扫描才能抓到。
  killed=0
  for pid in $(find_server_pids); do
    [ -n "$pid" ] || continue
    kill_pid "$pid" TERM 2>/dev/null && killed=1
  done
  if [ "$killed" = 1 ]; then
    i=0
    while [ "$i" -lt 20 ]; do
      [ -z "$(find_server_pids)" ] && break
      sleep 0.25
      i=$((i + 1))
    done
    for pid in $(find_server_pids); do
      [ -n "$pid" ] || continue
      kill_pid "$pid" KILL 2>/dev/null
    done
    sleep 0.5
  fi
  rm -f "$PID_FILE"
  exit 0
}

restart() {
  stop
  start
}

status() {
  local pid
  if pid="$(read_pid)" && pid_alive "$pid"; then
    exit 0
  fi
  # PID 文件缺失/对不上时按命令行扫：服务真在跑就不能报「未运行」。应用中心
  # 按这里的返回值显示运行状态，误报停用会让用户以为录像已经停了（152 真机
  # 2026-11-11 实发：显示停用、实际录了一整夜）。扫到就顺手把 PID 文件修好。
  for pid in $(find_server_pids); do
    [ -n "$pid" ] || continue
    printf '%s\n' "$pid" >"$PID_FILE" 2>/dev/null || true
    exit 0
  done
  # 最后一级：TCP 探测。跨用户执行时 kill -0 会因 EPERM 误判「不在」（哪怕进程
  # 就在眼前），TCP 连接与权限无关——连得上就是有服务在听这个端口。
  if port_alive "$PORT" || port_alive "$(tr -dc '0-9' <"$VAR_DIR/port.txt" 2>/dev/null)"; then
    exit 0
  fi
  rm -f "$PID_FILE"
  exit 3
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  status)  status ;;
  *)       echo "usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
